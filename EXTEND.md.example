# wx-lead-scanner 配置
#
# 复制此文件到以下路径之一：
#   .wx-lead-scanner/EXTEND.md           (项目目录)
#   ~/.wx-lead-scanner/EXTEND.md         (用户目录)

## 微信身份（必填）
self_wxid_prefix: wxid_你的前缀
self_display: 你的显示名

## 飞书 Base — 主 CRM（必填）
base_token: 你的飞书多维表格token
opportunity_table_id: tblXXXXXX
channel_table_id: tblYYYYYY

## 飞书 Base — 第二 CRM（可选，按业务线分流）
# 如果你有多条业务线（如 GEO + 培训），可配置第二个 Base
# second_base_token: 另一个飞书多维表格token
# second_opportunity_table_id: tblZZZZZZ
# second_channel_table_id: tblWWWWWW
# second_business_line: 培训

## 扫描范围（可选）
# max_group_size: 20
